{
  "name": "HA Backup Steward",
  "version": "0.1.13",
  "slug": "backup_steward",
  "description": "Backups L2/L3, offline disks and integrity checks in one app. Experimental; observe-only by default.",
  "url": "https://github.com/rpmlourenco/ha-backup-steward",
  "arch": [
    "aarch64",
    "amd64"
  ],
  "startup": "application",
  "boot": "manual",
  "stage": "experimental",
  "init": true,
  "timeout": 120,
  "hassio_api": true,
  "hassio_role": "manager",
  "homeassistant_api": true,
  "host_dbus": true,
  "journald": true,
  "udev": true,
  "full_access": true,
  "apparmor": false,
  "ingress": true,
  "ingress_port": 8099,
  "panel_icon": "mdi:shield-check-outline",
  "panel_title": "Backup Steward",
  "map": [
    {
      "type": "media",
      "read_only": false
    }
  ],
  "backup": "hot",
  "backup_exclude": [
    "*/state.tmp",
    "*.partial",
    "*.log"
  ],
  "ports": {
    "8100/tcp": null
  },
  "ports_description": {
    "8100/tcp": "Authenticated API (optional; use internal hostname on HAOS)"
  },
  "options": {
    "execution_mode": "observe",
    "legacy_scheduler_disabled": false,
    "schedule_enabled": false,
    "schedule_time": "04:00",
    "timezone": "Europe/Madrid",
    "checksum_frequency": "monthly",
    "checksum_weekday": 6,
    "checksum_month_week": 1,
    "source_uuid": "",
    "source_mount": "/media/NASRUI",
    "destination_uuid": "",
    "destination_mount": "/media/HAL3",
    "power_entity": "",
    "additional_sources": [
      "/media/immich",
      "/media/filebrowser"
    ],
    "l2_directory": "backups/home-assistant/level-2",
    "test_directory": "backup-steward-test",
    "l2_keep": 3,
    "history_days": 30,
    "min_free_gib": 100,
    "max_delete_files": 1000,
    "max_delete_gib": 100,
    "max_missing_fraction": 0.2,
    "transfers": 2,
    "checkers": 4,
    "backup_timeout_minutes": 360,
    "device_wait_seconds": 45,
    "legacy_scripts": [
      "script.level2_run_backup",
      "script.level3_run_backup"
    ],
    "encryption_password": "",
    "integrity_error_limit": 1000
  },
  "schema": {
    "execution_mode": "list(observe|test|production)",
    "legacy_scheduler_disabled": "bool",
    "schedule_enabled": "bool",
    "schedule_time": "str",
    "timezone": "str",
    "checksum_frequency": "list(monthly|weekly|disabled)",
    "checksum_weekday": "int",
    "checksum_month_week": "int",
    "source_uuid": "str",
    "source_mount": "str",
    "destination_uuid": "str",
    "destination_mount": "str",
    "power_entity": "str",
    "additional_sources": [
      "str"
    ],
    "l2_directory": "str",
    "test_directory": "str",
    "l2_keep": "int",
    "history_days": "int",
    "min_free_gib": "int",
    "max_delete_files": "int",
    "max_delete_gib": "int",
    "max_missing_fraction": "float",
    "transfers": "int",
    "checkers": "int",
    "backup_timeout_minutes": "int",
    "device_wait_seconds": "int",
    "legacy_scripts": [
      "str"
    ],
    "encryption_password": "password",
    "integrity_error_limit": "int(1,1000000)"
  },
  "homeassistant": "2026.10.0"
}
